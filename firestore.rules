rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 👉 Yahan dono users ke UID daalo (Firebase Console → Authentication → Users)
    function allowed() {
      return request.auth != null && request.auth.uid in ['UID_PERSON_1', 'UID_PERSON_2'];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
